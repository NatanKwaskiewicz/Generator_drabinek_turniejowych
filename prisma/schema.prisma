generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Tournament {
  id             Int              @id @default(autoincrement())
  name           String
  date           DateTime
  createdAt      DateTime         @default(now())
  formatId       Int
  TournamentTeam TournamentTeam[]
  Match          Match[]
  format         Format           @relation(fields: [formatId], references: [id], onDelete: Restrict)
}

model TeamMember {
  id       Int     @id @default(autoincrement())
  name     String
  nickname String?
  surname  String
  teamId   Int
  team     Teams   @relation(fields: [teamId], references: [id], onDelete: Cascade)
}

model Teams {
  id             Int              @id @default(autoincrement())
  name           String
  teamMembers    TeamMember[]
  TournamentTeam TournamentTeam[]
  matchesAsTeamA Match[]          @relation("MatchTeamA")
  matchesAsTeamB Match[]          @relation("MatchTeamB")
}

model TournamentTeam {
  tournamentId Int
  teamId       Int
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  team         Teams      @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@id([tournamentId, teamId])
}

model Match {
  id           Int     @id @default(autoincrement())
  tournamentId Int
  teamAId      Int
  teamBId      Int
  teamAScore   Int     @default(0)
  teamBScore   Int     @default(0)
  round        Int
  played       Boolean @default(false)

  teamA      Teams      @relation("MatchTeamA", fields: [teamAId], references: [id], onDelete: Restrict)
  teamB      Teams      @relation("MatchTeamB", fields: [teamBId], references: [id], onDelete: Restrict)
  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
}

model Format {
  id         Int          @id @default(autoincrement())
  name       String       @unique
  Tournament Tournament[]
}
